# Copia este archivo a ".env" (sin ".example") y llena tus valores reales.
# Codespaces SÍ persiste este archivo entre reinicios de la máquina —
# a diferencia de "export DATABASE_URL=..." en la terminal, que se
# pierde cada vez que apagas/reinicias el Codespace.

DATABASE_URL=postgresql://usuario:contraseña@ep-algo.neon.tech/neondb?sslmode=require&channel_binding=require
ADMIN_SECRET=inventa-una-clave-larga-y-dificil-de-adivinar
JWT_SECRET=inventa-otra-clave-distinta-para-firmar-sesiones
